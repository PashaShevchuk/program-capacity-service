# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Pretty-print logs locally; keep false in production (JSON logs).
LOG_PRETTY=true

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=capacity
DB_PASSWORD=capacity
DB_NAME=capacity
# Migrations are run explicitly (npm run migration:run); never use synchronize.
DB_RUN_MIGRATIONS_ON_BOOT=true

# ---------------------------------------------------------------------------
# Auth (JWT, HS256)
# ---------------------------------------------------------------------------
# Replace with a strong secret. Must be at least 32 characters.
JWT_SECRET=local-development-secret-change-me-please
JWT_ISSUER=program-capacity-service
JWT_AUDIENCE=program-capacity-clients
JWT_EXPIRES_IN=3600s

# Seeded demo credentials (created by `npm run seed`).
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_CLIENT_EMAIL=client@demo.local
SEED_CLIENT_PASSWORD=Client123!

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=program-capacity-service
KAFKA_CONSUMER_GROUP_ID=program-capacity-service
KAFKA_TOPIC_TREASURY_EVENTS=treasury.capacity.events.v1
KAFKA_TOPIC_TREASURY_RECONCILIATION=treasury.capacity.reconciliation.v1
KAFKA_TOPIC_CAPACITY_CHANGED=program.capacity.changed.v1
KAFKA_DLQ_SUFFIX=.dlq
KAFKA_MAX_PROCESSING_ATTEMPTS=3
KAFKA_RETRY_BASE_DELAY_MS=200

# ---------------------------------------------------------------------------
# Transactional outbox publisher
# ---------------------------------------------------------------------------
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
